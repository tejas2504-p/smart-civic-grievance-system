# =========================================================
# Smart Government Grievance Portal - Environment Configuration
# =========================================================

NODE_ENV=development

# 1. MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_grievance_portal?retryWrites=true&w=majority

# 2. Server Configuration
PORT=5000
JWT_SECRET=grievance_portal_jwt_secret_key_2026_secure
OTP_HASH_SECRET=gov_grievance_portal_otp_hmac_secret_salt_2026
VITE_API_URL=http://localhost:5000

# 3. Resend Official Email API
# Get your free Resend API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 4. Real SMS Provider (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=GOVMH
SMS_PROVIDER_TEMPLATE_ID=

# Twilio Specific (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 5. Demo Phone Number & OTP Policy
# In demo mode, real SMS OTP is dispatched ONLY to DEMO_PHONE_NUMBER (+91 8452940085)
OTP_DEMO_MODE=true
DEMO_PHONE_NUMBER=+918452940085
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=5

# 6. Cloudflare Turnstile Human Verification (CAPTCHA)
CAPTCHA_PROVIDER=cloudflare
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
