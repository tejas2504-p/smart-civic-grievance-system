# =========================================================
# Smart Government Grievance Portal - Environment Configuration
# =========================================================

# Environment Mode
NODE_ENV=development

# 1. MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_grievance_portal?retryWrites=true&w=majority

# 2. Server Configuration
PORT=5000
JWT_SECRET=grievance_portal_jwt_secret_key_2026_secure
OTP_HASH_SECRET=gov_grievance_portal_otp_hmac_secret_salt_2026
VITE_API_URL=http://localhost:5000

# 3. Cloudflare Turnstile Human Verification (CAPTCHA)
# Get your free Turnstile keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Default test keys for frictionless local development:
# Test Site Key: 1x00000000000000000000AA (Always Passes)
# Test Secret Key: 1x0000000000000000000000000000000AA (Always Passes)
CAPTCHA_PROVIDER=cloudflare
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 4. Indian SMS Provider (Twilio / Fast2SMS / MSG91)
# Options: 'twilio', 'fast2sms', 'msg91'
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=GOVMH

# If using Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# If using MSG91:
MSG91_TEMPLATE_ID=

# 5. Transactional Email Service (Nodemailer SMTP)
# Works with Gmail App Passwords, SendGrid, Amazon SES, Brevo, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM="Government Grievance Portal" <noreply@grievance.mh.gov.in>
